{
    "openapi": "3.1.0",
    "info": {
        "title": "Aplikasi Gas API",
        "version": "1.0.0",
        "servers": [
            {
                "url": "http://localhost:8080/api",
                "description": "Local Development"
            }
        ],
        "security": [
            {
                "bearerAuth": []
            }
        ]
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "Users": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "format": "password"
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "User": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "user_type": {
                        "type": "string"
                    }
                }
            },
            "PasswordUpdateRequest": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string"
                    },
                    "new_password": {
                        "type": "string"
                    }
                },
                "required": [
                    "current_password",
                    "new_password"
                ]
            },
            "Customers": {
                "type": "object",
                "properties": {
                    "nik": {
                        "type": "string"
                    },
                    "customer_name": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float"
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float"
                    }
                },
                "required": [
                    "nik",
                    "customer_name",
                    "phone",
                    "address",
                    "latitude",
                    "longitude"
                ]
            },
            "MasterItem": {
                "type": "object",
                "properties": {
                    "item_code": {
                        "type": "string"
                    },
                    "item_name": {
                        "type": "string"
                    },
                    "item_type": {
                        "type": "string",
                        "enum": [
                            "ITEM",
                            "SERVICE"
                        ]
                    },
                    "price": {
                        "type": "number",
                        "format": "float"
                    },
                    "flag_status": {
                        "type": "string",
                        "enum": [
                            "Y",
                            "N"
                        ]
                    }
                },
                "required": [
                    "item_code",
                    "item_name",
                    "item_type",
                    "price",
                    "flag_status"
                ]
            },
            "MasterItemCollection": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "item_code": {
                                    "type": "string"
                                },
                                "item_name": {
                                    "type": "string"
                                },
                                "item_type": {
                                    "type": "string"
                                },
                                "price": {
                                    "type": "number"
                                },
                                "flag_status": {
                                    "type": "string"
                                },
                                "id": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            },
            "MasterItemById": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "item_code": {
                        "type": "string"
                    },
                    "item_name": {
                        "type": "string"
                    },
                    "item_type": {
                        "type": "string"
                    },
                    "price": {
                        "type": "number"
                    },
                    "flag_status": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "StockItem": {
                "type": "object",
                "properties": {
                    "item_id": {
                        "type": "integer"
                    },
                    "filled_gas_id": {
                        "type": "integer",
                        "description": "Refers to gas in full cylinder (stock in)"
                    },
                    "empty_gas_id": {
                        "type": "integer",
                        "description": "Refers to empty cylinder (stock out)"
                    },
                    "initial_stock": {
                        "type": "integer"
                    },
                    "closing_stock": {
                        "type": "integer"
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    }
                },
                "required": [
                    "item_id",
                    "filled_gas_id",
                    "empty_gas_id",
                    "initial_stock",
                    "closing_stock",
                    "date"
                ]
            },
            "CurrentStock": {
                "type": "object",
                "properties": {
                    "filled_stock": {
                        "type": "integer"
                    },
                    "empty_stock": {
                        "type": "integer"
                    },
                    "total_stock": {
                        "type": "integer"
                    }
                }
            },
            "Transaction": {
                "type": "object",
                "properties": {
                    "trx_number": {
                        "type": "string"
                    },
                    "customer_id": {
                        "type": "integer"
                    },
                    "item_id": {
                        "type": "integer"
                    },
                    "quantity": {
                        "type": "number"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "total": {
                        "type": "number"
                    },
                    "description": {
                        "type": "string"
                    },
                    "created_by": {
                        "type": "integer"
                    },
                    "customer": {
                        "type": "object",
                        "properties": {
                            "nik": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            }
                        }
                    },
                    "item": {
                        "type": "object",
                        "properties": {
                            "item_name": {
                                "type": "string"
                            }
                        }
                    },
                    "receivable": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "invoice_number": {
                                "type": "string"
                            },
                            "total_amount": {
                                "type": "number"
                            },
                            "paid_amount": {
                                "type": "number"
                            },
                            "remaining_amount": {
                                "type": "number"
                            },
                            "status": {
                                "type": "string"
                            },
                            "receivable_items": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "item_id": {
                                            "type": "integer"
                                        },
                                        "qty": {
                                            "type": "number"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "paths": {}
}